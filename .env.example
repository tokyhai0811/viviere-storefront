# Leave both unset to run on the built-in mock catalogue and a localStorage cart.
# Set both to read products and keep the cart in a Medusa backend (see viviere-backend).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_...
# Regions are picked by currency: VND for visitors in Vietnam, USD for everyone else.
